# Copy to .env and fill in real values. The .env file is git-ignored.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/book
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password

# --- JWT ---
# Must be at least 32 characters: HMAC-SHA keys are derived from these raw bytes.
JWT_KEY=replace_with_a_long_random_secret_at_least_32_chars
# Token lifetime in milliseconds (600000 = 10 minutes).
JWT_EXPIRATION=600000

# --- Optional ---
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:4200
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_USER_AGENT=BookTracker/0.0.1
